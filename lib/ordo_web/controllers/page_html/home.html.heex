<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{gettext("Ordo — AI that resolves your store's support email")}</title>
    <meta
      name="description"
      content={
        gettext(
          "Ordo reads your support inbox, looks the order up in your shop, takes the action — status, returns, refunds — and replies to your customer. Built for European e-commerce."
        )
      }
    />
    <link rel="canonical" href="https://hireordo.com" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hireordo.com" />
    <meta
      property="og:title"
      content={gettext("Ordo — AI that resolves your store's support email")}
    />
    <meta
      property="og:description"
      content={
        gettext(
          "Reads every “where is my order?”, acts in your shop, replies to the customer. Copilot first, Autopilot when the numbers say so."
        )
      }
    />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer data-domain="hireordo.com" data-api="/api/event" src="/js/stats.js">
    </script>
    <style>
      html { scroll-behavior: smooth; }

      /* --- ticket resolution sequence --------------------------------- */
      .seq { opacity: 0; transform: translateY(6px); animation: rise .45s ease-out forwards; }
      .seq-1 { animation-delay: .4s; }
      .seq-2 { animation-delay: 1.3s; }
      .seq-3 { animation-delay: 2.1s; }
      .seq-4 { animation-delay: 2.9s; }
      .seq-5 { animation-delay: 3.7s; }
      @keyframes rise { to { opacity: 1; transform: translateY(0); } }

      .stamp {
        opacity: 0;
        transform: rotate(-8deg) scale(1.6);
        animation: thump .35s cubic-bezier(.2,.9,.3,1.4) forwards;
        animation-delay: 4.5s;
      }
      @keyframes thump { to { opacity: 1; transform: rotate(-8deg) scale(1); } }

      .cursor-dot { animation: blink 1s steps(1) infinite; }
      @keyframes blink { 50% { opacity: 0; } }

      @media (prefers-reduced-motion: reduce) {
        .seq, .stamp { animation: none; opacity: 1; transform: none; }
        .stamp { transform: rotate(-8deg); }
        html { scroll-behavior: auto; }
      }

      /* perforated divider — waybill edge */
      .perf {
        background-image: radial-gradient(circle, #CBD5E1 1.5px, transparent 1.6px);
        background-size: 14px 3px;
        background-repeat: repeat-x;
        background-position: center;
        height: 3px;
      }

      ::selection { background: #FFC53D; color: #16233B; }
    </style>
  </head>

  <body class="bg-paper text-ink font-body antialiased">
    
<!-- ── Nav ─────────────────────────────────────────────────────────── -->
    <header class="max-w-6xl mx-auto px-5 sm:px-8 pt-6 flex items-center justify-between">
      <div class="font-mono font-medium tracking-[0.35em] text-lg select-none">
        ORDO<span class="text-label-deep">.</span>
      </div>
      <nav class="flex items-center gap-4 sm:gap-6">
        <a
          href={if @locale == "en", do: ~p"/en/blog", else: ~p"/blog"}
          class="group relative font-mono text-sm font-medium text-ink py-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-label"
        >
          {gettext("Blog")}
          <span
            class="absolute -bottom-0.5 left-0 h-[2px] w-full origin-left scale-x-0 bg-label transition-transform duration-200 group-hover:scale-x-100"
            aria-hidden="true"
          >
          </span>
        </a>

        <span class="h-5 w-px bg-slate-300" aria-hidden="true"></span>
        <OrdoWeb.Layouts.locale_switcher locale={@locale} />
      </nav>
    </header>
    
<!-- ── Hero ────────────────────────────────────────────────────────── -->
    <main>
      <section class="max-w-6xl mx-auto px-5 sm:px-8 pt-14 pb-20 grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <div>
          <p class="font-mono text-xs tracking-[0.25em] text-ink-mute uppercase mb-5">
            {gettext("For stores on BaseLinker · Shoper · IdoSell")}
          </p>
          <h1 class="font-display font-bold text-4xl sm:text-5xl leading-[1.08] tracking-tight">
            {gettext("Support that")}<br />
            {gettext("answers")} <span class="relative inline-block"><span
                class="absolute inset-x-0 bottom-1 h-3 bg-label"
                aria-hidden="true"
              ></span><span class="relative">{gettext("itself")}</span></span>.
          </h1>
          <p class="mt-6 text-lg text-ink-soft max-w-md leading-relaxed">
            {gettext(
              "Ordo reads every “where is my order?”, looks the order up in your shop, takes the action — status, return, refund — and replies to your customer. You watch it work before you let it work alone."
            )}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="#early-access"
              class="bg-ink text-paper font-mono text-sm px-6 py-3 hover:bg-ink-soft transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-label"
            >
              {gettext("Hire Ordo")}
            </a>
            <a
              href={~p"/demo"}
              class="font-mono text-sm px-6 py-3 border border-ink hover:bg-ink hover:text-paper transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-label"
            >
              {gettext("See live demo")}
            </a>
            <span class="font-mono text-xs text-ink-mute">
              {gettext("3 pilot slots · free during pilot")}
            </span>
          </div>
        </div>
        
<!-- signature: the self-resolving ticket -->
        <div
          class="relative"
          aria-label={gettext("Example: Ordo resolving a customer message automatically")}
        >
          <div class="bg-paper-card border border-slate-300 shadow-[6px_6px_0_0_#16233B14]">
            
<!-- ticket head -->
            <div class="flex items-center justify-between px-5 py-3 border-b border-slate-200">
              <span class="font-mono text-xs text-ink-mute">{gettext("TICKET")}&nbsp;#4172</span>
              <span class="font-mono text-xs text-ink-mute">
                {gettext("order")}&nbsp;<span class="text-ink">ZAM-88317</span>
              </span>
            </div>

            <div class="px-5 py-4 space-y-3 text-sm">
              <!-- customer msg -->
              <div class="seq seq-1">
                <p class="font-mono text-[11px] text-ink-mute mb-1">14:02 · anna.k@…</p>
                <p class="bg-slate-100 px-3 py-2 leading-snug">
                  {gettext("Hi, I ordered a week ago and still nothing. Where is my package?")}
                </p>
              </div>
              
<!-- action log -->
              <div class="seq seq-2 font-mono text-[12px] text-ink-mute pl-3 border-l-2 border-label">
                → BaseLinker: get_order <span class="text-ink">ZAM-88317</span>
              </div>
              <div class="seq seq-3 font-mono text-[12px] text-ink-mute pl-3 border-l-2 border-label">
                ← {gettext("shipped 12 Aug")} · InPost <span class="text-ink">620441882</span>
                · {gettext("out for delivery")}
              </div>
              
<!-- reply -->
              <div class="seq seq-4">
                <p class="font-mono text-[11px] text-ink-mute mb-1">14:02 · Ordo</p>
                <p class="bg-ink text-paper px-3 py-2 leading-snug">
                  {gettext(
                    "Hi Anna! Your parcel left us on 12 Aug and is out for delivery today. Track it here: inpost.pl/620441882. It should reach your locker by 6 pm."
                  )}
                </p>
              </div>
              
<!-- resolution row -->
              <div class="seq seq-5 flex items-center justify-between pt-1">
                <span class="font-mono text-[11px] text-ink-mute">
                  {gettext("no human involved")}<span class="cursor-dot">_</span>
                </span>
                <span class="font-mono text-[11px] text-okay">47&nbsp;s</span>
              </div>
            </div>
          </div>
          
<!-- stamp -->
          <div class="stamp absolute -top-4 -right-2 sm:-right-5 border-[3px] border-okay text-okay font-mono font-medium tracking-[0.2em] text-sm px-3 py-1 bg-paper-card/80">
            {gettext("RESOLVED")}
          </div>
        </div>
      </section>

      <div class="perf max-w-6xl mx-auto"></div>
      
<!-- ── How it works (a real sequence → numbering is honest) ────────── -->
      <section class="max-w-6xl mx-auto px-5 sm:px-8 py-20">
        <h2 class="font-display font-bold text-3xl tracking-tight mb-12">
          {gettext("One email, three moves")}
        </h2>
        <div class="grid sm:grid-cols-3 gap-10">
          <div>
            <p class="font-mono text-label-deep text-sm mb-3">{gettext("01 / READ")}</p>
            <p class="text-ink-soft leading-relaxed">
              {gettext(
                "Ordo plugs into your support inbox and understands what the customer actually needs — in Polish, English, or 20+ other languages."
              )}
            </p>
          </div>
          <div>
            <p class="font-mono text-label-deep text-sm mb-3">{gettext("02 / ACT")}</p>
            <p class="text-ink-soft leading-relaxed">
              {gettext(
                "It looks the order up in your shop and does the work: checks tracking, registers the return, triggers the refund. Real actions, not canned answers."
              )}
            </p>
          </div>
          <div>
            <p class="font-mono text-label-deep text-sm mb-3">{gettext("03 / RESOLVE")}</p>
            <p class="text-ink-soft leading-relaxed">
              {gettext(
                "The customer gets a complete answer in under a minute, the ticket closes itself, and your inbox stays quiet."
              )}
            </p>
          </div>
        </div>
      </section>

      <div class="perf max-w-6xl mx-auto"></div>
      
<!-- ── Trust: copilot → autopilot ──────────────────────────────────── -->
      <section class="max-w-6xl mx-auto px-5 sm:px-8 py-20 grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="font-display font-bold text-3xl tracking-tight mb-6">
            {gettext("You promote it.")}<br />{gettext("It doesn't promote itself.")}
          </h2>
          <p class="text-ink-soft leading-relaxed max-w-md">
            {gettext("Every ticket category starts in")} <strong class="text-ink">{gettext("Copilot")}</strong>{gettext(
              ": Ordo drafts, you approve. When its drafts stop needing edits, you switch that category to"
            )}
            <strong class="text-ink">{gettext("Autopilot")}</strong>
            {gettext(
              "— one at a time, based on numbers, not promises. Refunds can stay human-approved forever if that's how you sleep better."
            )}
          </p>
        </div>
        <div class="space-y-3 font-mono text-sm">
          <div class="flex items-center justify-between border border-slate-300 bg-paper-card px-4 py-3">
            <span>{gettext("“Where is my order?”")}</span>
            <span class="text-okay border border-okay px-2 py-0.5 text-xs">
              {gettext("AUTOPILOT")}
            </span>
          </div>
          <div class="flex items-center justify-between border border-slate-300 bg-paper-card px-4 py-3">
            <span>{gettext("Returns & exchanges")}</span>
            <span class="text-okay border border-okay px-2 py-0.5 text-xs">
              {gettext("AUTOPILOT")}
            </span>
          </div>
          <div class="flex items-center justify-between border border-slate-300 bg-paper-card px-4 py-3">
            <span>{gettext("Refunds")}</span>
            <span class="text-ink-mute border border-slate-400 px-2 py-0.5 text-xs">
              {gettext("COPILOT")}
            </span>
          </div>
          <div class="flex items-center justify-between border border-slate-300 bg-paper-card px-4 py-3">
            <span>{gettext("Complaints")}</span>
            <span class="text-ink-mute border border-slate-400 px-2 py-0.5 text-xs">
              {gettext("HUMAN ONLY")}
            </span>
          </div>
        </div>
      </section>

      <div class="perf max-w-6xl mx-auto"></div>
      
<!-- ── Integrations ────────────────────────────────────────────────── -->
      <section class="max-w-6xl mx-auto px-5 sm:px-8 py-16">
        <p class="font-mono text-xs tracking-[0.25em] text-ink-mute uppercase mb-6">
          {gettext("Works with")}
        </p>
        <div class="flex flex-wrap gap-3 font-mono text-sm">
          <span class="border border-slate-300 bg-paper-card px-4 py-2">BaseLinker</span>
          <span class="border border-slate-300 bg-paper-card px-4 py-2">Shoper</span>
          <span class="border border-slate-300 bg-paper-card px-4 py-2">IdoSell</span>
          <span class="border border-slate-300 bg-paper-card px-4 py-2">InPost</span>
          <span class="border border-slate-300 bg-paper-card px-4 py-2">Gmail / IMAP</span>
          <span class="border border-slate-300 bg-paper-card px-4 py-2">
            {gettext("Google reviews")}
          </span>
          <span class="border border-dashed border-slate-400 text-ink-mute px-4 py-2">
            Allegro — {gettext("soon")}
          </span>
        </div>
      </section>

      <div class="perf max-w-6xl mx-auto"></div>
      
<!-- ── Early access ────────────────────────────────────────────────── -->
      <section id="early-access" class="max-w-6xl mx-auto px-5 sm:px-8 py-20">
        <div class="max-w-xl">
          <h2 class="font-display font-bold text-3xl tracking-tight mb-4">
            {gettext("Pilot program")}
          </h2>
          <p class="text-ink-soft leading-relaxed mb-8">
            {gettext(
              "We're onboarding three stores that get 300+ support emails a month. Free during the pilot, direct line to the founder, and your workflows shape what Ordo becomes. If that's you, leave your email."
            )}
          </p>
          <form
            id="pilot-form"
            method="post"
            action={~p"/pilot"}
            class="flex flex-col sm:flex-row gap-3"
          >
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <label for="email" class="sr-only">{gettext("Your work email")}</label>
            <input
              id="email"
              name="pilot_request[email]"
              type="email"
              required
              placeholder="you@yourstore.pl"
              class="flex-1 border border-ink bg-paper-card px-4 py-3 font-mono text-sm placeholder:text-ink-mute focus:outline-none focus-visible:ring-2 focus-visible:ring-label"
            />
            <button
              type="submit"
              class="bg-ink text-paper font-mono text-sm px-6 py-3 hover:bg-ink-soft transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-label"
            >
              {gettext("Request a slot")}
            </button>
          </form>
          <p
            id="form-note"
            data-default={gettext("We reply within one business day. No newsletter, no spam.")}
            data-sent={
              gettext("Thanks — we've got your email and will reply within one business day.")
            }
            data-error={
              gettext("Something went wrong. Please write us directly: hello@hireordo.com")
            }
            class={[
              "font-mono text-xs mt-3",
              @pilot_status == "sent" && "text-label-deep",
              @pilot_status == "error" && "text-red-600",
              @pilot_status not in ["sent", "error"] && "text-ink-mute"
            ]}
          >
            <%= case @pilot_status do %>
              <% "sent" -> %>
                {gettext("Thanks — we've got your email and will reply within one business day.")}
              <% "error" -> %>
                {gettext("Something went wrong. Please write us directly: hello@hireordo.com")}
              <% _ -> %>
                {gettext("We reply within one business day. No newsletter, no spam.")}
            <% end %>
          </p>
        </div>
      </section>
    </main>
    
<!-- ── Footer ──────────────────────────────────────────────────────── -->
    <footer class="border-t border-slate-300">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <span class="font-mono text-xs tracking-[0.35em]">
          ORDO<span class="text-label-deep">.</span>
        </span>
        <span class="font-mono text-xs text-ink-mute">
          {gettext("Built in Gdańsk, EU")} · hello@hireordo.com
        </span>
      </div>
    </footer>

    <script>
      // Submit the pilot form without reloading the page. Falls back to a normal
      // POST + redirect if JS is disabled (see PageController.pilot/2).
      (function () {
        var form = document.getElementById('pilot-form');
        var note = document.getElementById('form-note');
        if (!form) return;

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var button = form.querySelector('button[type="submit"]');
          if (button) button.disabled = true;

          fetch(form.action, {
            method: 'POST',
            headers: { 'x-requested-with': 'fetch' },
            body: new FormData(form)
          })
            .then(function (res) {
              if (res.ok) {
                form.reset();
                note.textContent = note.dataset.sent;
                note.classList.remove('text-ink-mute', 'text-red-600');
                note.classList.add('text-label-deep');
              } else {
                throw new Error('request failed');
              }
            })
            .catch(function () {
              note.textContent = note.dataset.error;
              note.classList.remove('text-ink-mute', 'text-label-deep');
              note.classList.add('text-red-600');
            })
            .finally(function () {
              if (button) button.disabled = false;
            });
        });
      })();
    </script>
  </body>
</html>
